{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/promo-voucher",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/e/:slug",
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/promotions/:file(mirela-640\\.webp|mirela-1024\\.webp|mirela-1280\\.webp|mirela-1024\\.jpg|mirela-avatar\\.webp|og\\.jpg)",
      "destination": "/api/promo-asset?f=:file"
    }
  ]
}
